{
  "name": "frontend-engineer-codecheck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.vue\" \"src/**/*.css\" --allow-empty-input",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "check": "pnpm lint && pnpm lint:styles && pnpm format:check && pnpm typecheck"
  },
  "dependencies": {
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.1",
    "postcss-html": "2.0.0",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11"
  }
}
